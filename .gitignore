# ── Secrets ──
.env
*_api
*_token

# ── Python ──
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Generated runs ──
outputs/
runs*/

# ── Gold / reference material: NOT for the public repo ──
docs/
gold.docx
cases/tasks/_local/

# ── Binary documents: ignored by default, whitelist what the repo needs ──
*.docx
*.pdf
*.pptx
!assets/reference.docx

# ── Local scratch (strays now collected under docs/_scratch/) ──
/test.md
/test2.md
_scratch/

# ── Junk ──
~$*
