# AI4Proposal 配置模板 —— 复制为 .env 并填入你自己的密钥
# .env 已在 .gitignore 中排除，不会被提交

# ── 文本 LLM（必需）──
AI4PROPOSAL_API_KEY=sk-your-key-here
AI4PROPOSAL_BASE_URL=https://api.deepseek.com
AI4PROPOSAL_MODEL=deepseek-v4-pro
AI4PROPOSAL_TIMEOUT_SECONDS=300

# ── 出图（可选；留空则退化为文字占位符）──
AI4PROPOSAL_IMAGE_API_KEY=
AI4PROPOSAL_IMAGE_BASE_URL=https://api.chatanywhere.tech/v1
AI4PROPOSAL_IMAGE_MODEL=gpt-image-2

# ── 评审时的外部检索（可选）──
# OpenAlex 免密钥；填邮箱可进入更快的礼貌池
AI4PROPOSAL_MAILTO=
# 仅在改用 Semantic Scholar 时需要
AI4PROPOSAL_S2_API_KEY=

# 检索默认校验 TLS 证书，失败时自动降级并告警。
# 若你的网络必然拆包（公司网/VPN），设为 1 可跳过首次校验尝试，省一次往返。
AI4PROPOSAL_INSECURE_TLS=
