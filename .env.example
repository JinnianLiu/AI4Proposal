# AI4Proposal Configuration
# Copy this to .env and fill in your keys

# LLM Provider (required)
AI4PROPOSAL_API_KEY=sk-your-key-here
AI4PROPOSAL_BASE_URL=https://api.openai.com/v1
AI4PROPOSAL_MODEL=gpt-4.1

# Image Generation (optional)
AI4PROPOSAL_IMAGE_API_KEY=sk-your-key-here
AI4PROPOSAL_IMAGE_MODEL=gpt-image-2

# Evaluation LLM (optional, defaults to main LLM)
AI4PROPOSAL_EVAL_API_KEY=
AI4PROPOSAL_EVAL_MODEL=
